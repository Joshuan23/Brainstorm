# --- Paywall / Stripe ---------------------------------------------------
# Create a product + recurring price in the Stripe dashboard, then set:
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PRICE_ID=price_...
# Random long string used to sign the Pro entitlement cookie:
ENTITLEMENT_SECRET=generate-a-long-random-string

# Without STRIPE_* set, the app runs the paywall in demo mode: the upgrade
# button grants a 24h "Pro (demo)" pass so the full flow can be tested.
