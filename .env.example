# --- Business Builder agent ---------------------------------------------
# The autonomous agent in builder/ uses the Anthropic API. Get a key at
# https://console.anthropic.com and set:
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (sensible defaults if unset):
# BUILDER_MODEL=claude-opus-4-8     # the model that powers the agent
# BUILDER_EFFORT=high               # low | medium | high | xhigh | max
# BUILDER_MAX_TURNS=40              # max model turns per work session
# BUILDER_AUTO_APPROVE=1            # run commands without confirmation

# --- Paywall / Lemon Squeezy --------------------------------------------
# Lemon Squeezy is the merchant of record (handles global sales tax/VAT).
# Create a store + subscription product ($29/mo) with "Generate license
# keys" enabled, then set:

# The product's hosted checkout link (Share > Checkout link):
LEMONSQUEEZY_CHECKOUT_URL=https://YOURSTORE.lemonsqueezy.com/buy/UUID

# Optional but recommended — pin license keys to your store/product
# (numeric ids, shown in the dashboard URL / product settings):
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=

# Random long string used to sign the Pro entitlement cookie:
ENTITLEMENT_SECRET=generate-a-long-random-string

# Without LEMONSQUEEZY_CHECKOUT_URL set, the app runs the paywall in demo
# mode: the upgrade button grants a 24h "Pro (demo)" pass so the full flow
# can be tested locally.
