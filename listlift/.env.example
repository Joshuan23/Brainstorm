# --- Public site URL (used for canonical URLs, sitemap, JSON-LD) ---------
NEXT_PUBLIC_SITE_URL=https://listlift.app

# --- Paywall / Gumroad ---------------------------------------------------
# Gumroad is the merchant of record (handles global sales tax/VAT).
# Create a $19/mo membership product with "Generate a unique license key
# per sale" enabled, then set:

# The product's checkout / share link (Share > Copy URL):
GUMROAD_CHECKOUT_URL=https://YOURNAME.gumroad.com/l/PERMALINK

# The product id the license key is verified against. Prefer GUMROAD_PRODUCT_ID
# (Product > Settings > Advanced > "Product ID"). If you only have the short
# URL slug, set GUMROAD_PRODUCT_PERMALINK instead (the part after /l/).
GUMROAD_PRODUCT_ID=
# GUMROAD_PRODUCT_PERMALINK=

# Random long string used to sign the Pro entitlement cookie:
ENTITLEMENT_SECRET=generate-a-long-random-string

# Without GUMROAD_CHECKOUT_URL + a product id set, the app runs the paywall in
# demo mode: the upgrade button grants a 24h "Pro (demo)" pass so the full flow
# can be tested locally.

# --- Optional LLM enhancement (leave blank to use the built-in engine) ---
# The rule-based engine works with zero keys. If you add an OpenAI-compatible
# key, Pro generations get an extra LLM polish pass on descriptions.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
